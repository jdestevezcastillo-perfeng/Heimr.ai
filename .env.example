# Heimr Docker Quickstart — Environment Variables
# Copy to .env and adjust as needed: cp .env.example .env

# --- LLM Configuration ---
# Ollama model to use (pulled automatically on first run)
# Options: qwen3.5:4b (fast, ~3.4GB), qwen3.5:9b (balanced, ~6.6GB), qwen3.5:27b (best, ~17GB)
OLLAMA_MODEL=qwen3.5:9b

# LLM URL (auto-configured for the compose stack — only change for external LLM)
# LLM_URL=http://ollama:11434/v1

# --- Cloud LLM (optional — uncomment to use instead of Ollama) ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- Agent Settings ---
# Gate policy: strict (REJECT on any issue) or advisory (WARN only)
GATE_POLICY=advisory

# Heimr command: "agent" (AI-powered) or "analyze" (no LLM required)
HEIMR_CMD=agent

# --- k6 Test ---
# Duration of the k6 load test
K6_DURATION=1m
# Number of virtual users at peak
K6_VUS=10
